/*
!/WarLegendRaidTool/
!/WarLegendRaidTool_Raid/
!/WarLegendRaidTool_PvP/
!/WarLegendRaidTool_Skyborne/
!/WarLegendRaidTool_Dev/
!/.gitignore
!/.gitattributes
# GitHub landing page and the players' release notes (not in the release zip)
!/README.md
!/CHANGELOG.md
# only our workflows, Dependabot and the landing page logo: the rest of .github on disk belongs to EllesmereUI
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/wlrt-release.yml
!/.github/workflows/wlrt-build-watch.yml
!/.github/workflows/wlrt-ci.yml
!/.github/workflows/wlrt-deps-watch.yml
!/.github/dependabot.yml
!/.github/assets/
/WarLegendRaidTool/*.rar
/WarLegendRaidTool/*.zip
*.bak
!/CLAUDE.md
!/docs/
!/tools/
/tools/node_modules/
/tools/.cache/
